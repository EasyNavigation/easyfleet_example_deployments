// Router for the "central island" of this deployment: the one
// navigation_manager_node, easynav_collaboration_mission_node, and any
// tui/cli tooling connect to (see launch/easynav_collaboration_launch.yaml,
// which starts this router before including robot_1_launch.yaml/
// robot_2_launch.yaml).
//
// No access_control block here on purpose: the robot-side isolation (only
// the whitelisted topics/actions cross a robot's island boundary) is already
// fully enforced, bidirectionally, by each robot's OWN router ACL (see
// robot_1/zenoh_router.json5, robot_2/zenoh_router.json5) -- even without
// any ACL here, robot_1 and robot_2 still cannot see each other through this
// router, because each robot's own router independently rejects, on
// ingress, anything arriving from here that isn't on its whitelist. See
// zenoh.md ("Punto 4") for the full reasoning. A central-side ACL could
// still be added later as defense in depth; not needed for the isolation
// property itself.
{
  id: "2eb9cdde96294731adf24825bb559420",
  mode: "router",
  listen: { endpoints: ["tcp/127.0.0.1:7447"] },
  scouting: { multicast: { enabled: false } },
}
