repositories:
  EasyFleet:
    type: git
    url: https://github.com/EasyNavigation/EasyFleet.git
    version: rolling
  EasyNavigation:
    type: git
    url: https://github.com/EasyNavigation/EasyNavigation.git
    version: rolling
  easynav_plugins:
    type: git
    url: https://github.com/EasyNavigation/easynav_plugins.git
    version: rolling
  NavMap:
    type: git
    url: https://github.com/EasyNavigation/NavMap.git
    version: rolling
  yaets:
    type: git
    url: https://github.com/fmrico/yaets.git
    version: rolling
  easynav_playgrounds:
    type: git
    url: https://github.com/EasyNavigation/easynav_playgrounds.git
    version: rolling
  large_warehouse_world:
    type: git
    url: https://github.com/juanscelyg/large_warehouse_world.git
    version: main
  # PlanSys2 with Kairos, for easyfleet_plansys2_warehouse_deployment.
  ros2_planning_system:
    type: git
    url: https://github.com/PlanSys2/ros2_planning_system.git
    version: rolling
  kairos:
    type: git
    url: https://github.com/PlanSys2/kairos.git
    version: main
  popf:
    type: git
    url: https://github.com/fmrico/popf.git
    version: rolling-devel
  cascade_lifecycle:
    type: git
    url: https://github.com/fmrico/cascade_lifecycle.git
    version: rolling-devel
  # No released .deb for rolling (needed by easynav_fusion_localizer).
  robot_localization:
    type: git
    url: https://github.com/cra-ros-pkg/robot_localization.git
    version: rolling-devel
